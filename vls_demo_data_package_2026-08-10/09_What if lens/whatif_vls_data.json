  "watched_measures": [
    {
      "key": "enf",
      "label": "Inherited open enforcement",
      "unit": "actions",
      "source": "ECHO",
      "grounds": "CONCEPT:Enforcement \u00b7 ENFORCEMENT_AGAINST",
      "field": "enforcement",
      "format": "integer",
      "inherited": true,
      "baseline_field": "enf",
      "appetite_field": "enf",
      "breach": {
        "op": ">=",
        "against": "appetite.enf"
      }
    },
    {
      "key": "penalty",
      "label": "Inherited penalty exposure",
      "unit": "$",
      "source": "ECHO",
      "grounds": "MEAS:penalty_amount (summable)",
      "field": "penalty",
      "format": "currency_k",
      "inherited": true,
      "baseline_field": "penalty",
      "appetite_field": null,
      "breach": null
    },
    {
      "key": "viols",
      "label": "Inherited open violations",
      "unit": "",
      "source": "RCRA",
      "grounds": "CONCEPT:Violation \u00b7 VIOLATION_AT",
      "field": "violations",
      "format": "integer",
      "inherited": true,
      "baseline_field": "viols",
      "appetite_field": null,
      "breach": null
    },
    {
      "key": "cd",
      "label": "Consent-decree / CAFO exposure",
      "unit": "",
      "source": "DOC",
      "grounds": "CONCEPT:Document \u00b7 DESCRIBED_BY",
      "field": "consent_decree",
      "format": "boolean_yesno",
      "inherited": true,
      "baseline_field": null,
      "appetite_field": null,
      "breach": null
    }
  ],
  "formats": {
    "integer": {
      "template": "{v}",
      "desc": "whole number, printed as-is"
    },
    "currency_k": {
      "template": "${v/1000}k",
      "desc": "USD divided by 1000, rounded to whole, suffixed 'k' (e.g. 397500 -> $398k)"
    },
    "boolean_yesno": {
      "template": "{v?yes:no}",
      "desc": "1/true -> 'yes', 0/false -> 'no'"
    }
  },
  "resolvable": [
    {
      "keywords": [
        "penalty",
        "fine",
        "dollar",
        "exposure"
      ],
      "resolves_to": "penalty",
      "verdict": "resolved",
      "note": "grounds to MEAS:penalty_amount \u2014 a summable measure element"
    },
    {
      "keywords": [
        "enforcement",
        "action"
      ],
      "resolves_to": "enf",
      "verdict": "resolved",
      "note": "grounds to CONCEPT:Enforcement via ENFORCEMENT_AGAINST"
    },
    {
      "keywords": [
        "violation",
        "viol"
      ],
      "resolves_to": "viols",
      "verdict": "resolved",
      "note": "grounds to CONCEPT:Violation via VIOLATION_AT"
    },
    {
      "keywords": [
        "consent",
        "decree",
        "cafo"
      ],
      "resolves_to": "cd",
      "verdict": "resolved",
      "note": "grounds to CONCEPT:Document via DESCRIBED_BY"
    },
    {
      "keywords": [
        "tons",
        "tonnage",
        "quantity",
        "volume"
      ],
      "resolves_to": null,
      "verdict": "grounds_not_inherited",
      "note": "grounds to MEAS:quantity_tons \u2014 but it measures the Manifest, not inherited risk; add it to a Report instead"
    }
  ],
  "resolve_copy": {
    "resolved": {
      "tone": "ok",
      "title": "Resolved \u2014 \"{label}\" added."
    },
    "grounds_not_inherited": {
      "tone": "warn",
      "title": "Grounds, but not as an inherited-risk measure."
    },
    "refused": {
      "tone": "bad",
      "title": "Doesn't ground.",
      "body": "Nothing in this graph resolves \"{q}\". A measure that doesn't map to a relationship or measure element can't be watched \u2014 author it in Reports first, or rephrase."
    }
  },
  "candidate_pools": [
    {
      "key": "all",
      "label": "All inbound generators",
      "filter": null
    },
    {
      "key": "enf",
      "label": "Under enforcement",
      "filter": {
        "op": ">",
        "field": "enforcement",
        "value": 0
      }
    },
    {
      "key": "oos",
      "label": "Out-of-state",
      "filter": {
        "op": "!=",
        "field": "state",
        "value": "TX"
      }
    },
    {
      "key": "cd",
      "label": "Under a consent decree / CAFO",
      "filter": {
        "op": "==",
        "field": "consent_decree",
        "value": true
      }
    }
  ],
  "authoring": {
    "steps": [
      {
        "n": 1,
        "key": "watch",
        "title": "Watched measures",
        "heading": "What are you watching move?",
        "help": "These are governed measures the graph already computes \u2014 pick the ones each candidate load should be judged against.",
        "add_measure": {
          "label": "Add a measure the graph can support",
          "placeholder": "e.g. inherited penalty dollars, out-of-state days in possession\u2026",
          "button": "Resolve against graph",
          "help": "A watched measure is the same object as a Report \u2014 it must ground to a real relationship in this graph before it can be watched. What doesn't ground is refused, not invented."
        }
      },
      {
        "n": 2,
        "key": "pool",
        "title": "Candidate pool",
        "heading": "Which loads can a scenario draw from?",
        "help": "This is the frame \u2014 the Runtime dropdowns only offer loads from this pool. Narrow it to the generators worth stress-testing.",
        "preview_rows": 8,
        "graph_link": "\u25c8 Show the graph this pool references"
      },
      {
        "n": 3,
        "key": "review",
        "title": "Review",
        "heading": "Review",
        "note": "This is a read-only overlay. Running a scenario admits a candidate load into the graph hypothetically and traces what it connects to \u2014 the generator's federal compliance record and any public enforcement. Nothing is accepted by saving; a scenario never writes to the graph. The residual \u2014 records not yet connected to a generator \u2014 is stated in Runtime, not hidden."
      }
    ],
    "scenario_count": {
      "heading": "How many scenarios do you want side by side?",
      "help": "Each scenario is independent \u2014 its own candidate load. You'll pick and swap the actual loads in Runtime.",
      "options": [
        1,
        2,
        3
      ],
      "default": 2
    },
    "cta_step1": "Continue \u2014 choose the pool \u2192",
    "cta_step2": "Continue \u2014 review \u2192",
    "cta_step3": "Save frame & run \u2192"
  },
  "runtime": {
    "compare": {
      "min": 1,
      "max": 3,
      "default": 2,
      "help": "\u201cAdd to compare\u201d opens a saved scenario as a new column beside the others \u2014 it never replaces one. Each stores only the admitted load; re-opening recomputes against today's graph."
    },
    "scenario_card": {
      "load_label": "Candidate load \u2014 the lever",
      "name_placeholder": "Name this scenario (e.g. Accept Arkema load)",
      "trace_link": "\u25b8 Trace every flag to its source record",
      "trace_header": "These figures come from three federal sources plus enforcement documents \u2014 no value is invented.",
      "residual_note": "Risk from records not yet connected to this generator is not in these figures \u2014 the scenario states what it cannot yet see rather than implying completeness.",
      "clean_note": "No open violations or enforcement connect to this load.",
      "graph_link": "\u25c8 Show the graph this references"
    },
    "headroom": {
      "label": "Headroom \u2014 the inverse question",
      "formula": "floor((appetite.enf - baseline.enf) / avg_enforcement_of_carrying_generators_in_pool)",
      "measure": "enf",
      "against": "appetite.enf",
      "sentence": "{room} more enforcement-carrying load(s) before inherited open enforcement crosses the facility's {appetite}-action appetite line",
      "help": "From this pool, enforcement-carrying generators average {avg} actions each. Goal-Seek-style break point, computed from the same records \u2014 not a forecast."
    },
    "saved_library": {
      "title": "Saved scenario library",
      "stores": "admitted_load_only",
      "empty": "None yet. Save a column above to keep it here \u2014 the library stores the admitted load only, and every figure recomputes when you re-open it.",
      "full_help": "Compare strip is full (3). Remove a column to add another.",
      "save_btn": "\uff0b Save this scenario",
      "update_btn": "\u21bb Update saved scenario",
      "saved_flag": "\u2713 Saved to library",
      "add_btn": "Add to compare",
      "default_name_template": "Accept {first_two_words_of_generator} load"
    },
    "closing_note": "Swap a load and every figure recomputes by traversal, live. What a spreadsheet can't do is inherit a generator's entire federal record the moment you consider its load. A saved scenario stores only the admitted load \u2014 never the numbers \u2014 so it stays live as the graph changes.",
    "sources": [
      {
        "key": "MAN",
        "label": "e-Manifest",
        "color": "blue",
        "line": "via {transporter} \u00b7 {manifests} manifests \u00b7 {tons} tons"
      },
      {
        "key": "RCRA",
        "label": "RCRAInfo",
        "color": "purple",
        "line": "{id} \u00b7 {evaluations} evaluations \u00b7 {violations} open violation(s)"
      },
      {
        "key": "ECHO",
        "label": "ECHO",
        "color": "red",
        "line": "{enforcement} enforcement action(s) \u00b7 last {last_enforcement}  |  no public enforcement"
      },
      {
        "key": "DOC",
        "label": "Document",
        "color": "amber",
        "line": "Under consent decree / CAFO \u00b7 DESCRIBED_BY {name}"
      }
    ]
  },
