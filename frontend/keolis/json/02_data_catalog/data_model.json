    {
      "suggestion_id": "sg_kv_resp_asset_scope",
      "from_table_key": "contract.responsibility_assignment",
      "from_column": "asset_scope",
      "to_table_key": "eam.asset_register",
      "to_column": "asset_id",
      "relationship_type": "ASSIGNS_RESPONSIBILITY_FOR",
      "relationship_type_alternatives": [
        "COVERS_ASSET",
        "SCOPES"
      ],
      "cardinality_hint": "N:N",
      "rationale": "asset_scope holds ranges ('BUS-201..BUS-208') as well as single asset_ids, so an equality join matches only the single-asset rows. Declare it as a range relationship, or expand the ranges in the contract register first.",
      "confidence": 0.62
    },
    {
      "suggestion_id": "sg_kv_wo_project",
      "from_table_key": "eam.work_order",
      "from_column": "project_code",
      "to_table_key": "ppm.project",
      "to_column": "project_code",
      "relationship_type": "PART_OF_PROJECT",
      "relationship_type_alternatives": [
        "CHARGED_TO",
        "DELIVERS"
      ],
      "cardinality_hint": "N:1",
      "rationale": "work_order.project_code is populated on 5.9% of orders (project tasks). The rest are maintenance and must not be attributed to a project because the asset is linked to one.",
