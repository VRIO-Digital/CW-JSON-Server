# Keeps the build context small and stops host artefacts leaking into an image.
#
# Note what is NOT here: scripts/ and .npmrc are needed by `npm ci` (postinstall
# runs the audit gate), mock-server/db.json is the only data the app has, and
# deploy/ holds the nginx template Dockerfile.web copies in.

.git
.github
.claude
node_modules
dist
dist-ssr
docs
*.log
*.local

# Transient file from the db.json editor's atomic write.
mock-server/db.json.tmp

# Throwaway SSR verification scripts.
smoke.tsx
