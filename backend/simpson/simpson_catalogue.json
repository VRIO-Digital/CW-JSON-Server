        "suggestion_id": "sg_rsp_notice_contract",
        "from_table_key": "proc.supplier_price_notice",
        "from_column": "supplier_id",
        "to_table_key": "proc.supplier_contract_term",
        "to_column": "supplier_id",
        "relationship_type": "VALIDATED_AGAINST",
        "relationship_type_alternatives": [
          "GOVERNED_BY"
        ],
        "cardinality_hint": "N:1",
        "rationale": "A notice's valid_from should be received_on plus the notice days of the supplier's price-change term. The join is on supplier_id; where a supplier has two contracts the clause must be picked by family.",
        "confidence": 0.78
      },
      {
        "suggestion_id": "sg_rsp_margin_duty",
        "from_table_key": "fin.margin_monthly",
        "from_column": "family_code",
        "to_table_key": "trade.duty_line",
        "to_column": "entry_id",
        "relationship_type": "RECOGNISES",
        "relationship_type_alternatives": [
          "TURNS_FROM"
        ],
        "cardinality_hint": "N:N",
        "rationale": "Duty in cost of sales is recognised as inventory turns, not as entries are filed. A direct join of monthly duty to entries by family overstates the month; declare it as an allocation, not a join.",
        "confidence": 0.58
      },
      {
        "suggestion_id": "sg_rsp_sellthrough_invoice",
        "from_table_key": "sales.dealer_sell_through",
        "from_column": "dealer_id",
        "to_table_key": "sales.invoice_line",
        "to_column": "customer_id",
        "relationship_type": "SOLD_THROUGH",
        "relationship_type_alternatives": [
          "RESOLD"
        ],
        "cardinality_hint": "N:N",
        "rationale": "Dealer sell-through is the builder's purchases from the dealer, not RSP's invoices to the dealer. Joining them equates two different events.",
        "confidence": 0.44
      },
      {
        "suggestion_id": "sg_rsp_realisation_event",
