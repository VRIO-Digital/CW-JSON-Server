        "suggestion_id": "sg_bw_allocation_receipt",
        "from_table_key": "pur.po_line",
        "from_column": "vendor_id",
        "to_table_key": "src.contract",
        "to_column": "vendor_id",
        "relationship_type": "ALLOCATED_UNDER",
        "relationship_type_alternatives": [
          "CONSTRAINED_BY"
        ],
        "cardinality_hint": "N:1",
        "rationale": "Corrigan's ferric lines since 12 October ship at 60% under a force majeure the contract table does not hold as a state; the allocation lives in a notice. The join is on vendor only, so it cannot say which lines are allocated.",
        "confidence": 0.64
      },
      {
        "suggestion_id": "sg_bw_reservation_receipt",
        "from_table_key": "mm.reservation",
        "from_column": "material_code",
        "to_table_key": "pur.po_line",
        "to_column": "material_code",
        "relationship_type": "FULFILLED_BY",
        "relationship_type_alternatives": [
          "AWAITS"
        ],
        "cardinality_hint": "N:N",
        "rationale": "A reservation is met from stock or from an open order line for the same material and site; nothing names which line is meant for which reservation, so the join is at material and site.",
        "confidence": 0.72
      },
      {
        "suggestion_id": "sg_bw_bid_contract",
        "from_table_key": "src.bid",
        "from_column": "material_code",
        "to_table_key": "src.contract_item",
        "to_column": "material_code",
        "relationship_type": "COMPARED_WITH",
        "relationship_type_alternatives": [
          "REPLACES"
        ],
        "cardinality_hint": "N:1",
        "rationale": "A bid is compared with the expiring contract price for the same material; the bid carries freight separately while some contract prices are delivered, so the comparison is only like for like on landed cost.",
        "confidence": 0.69
      },
      {
        "suggestion_id": "sg_bw_dosing_stock",
