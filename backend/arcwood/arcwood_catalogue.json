    "suggestions": [
      {
        "suggestion_id": "sg_ib_legacy_merge",
        "from_table_key": "legacy.legacy_profile",
        "from_column": "ironbridge_profile_id",
        "to_table_key": "ops.waste_profile",
        "to_column": "profile_id",
        "relationship_type": "SAME_PROFILE_AS",
        "relationship_type_alternatives": [
          "SUPERSEDED_BY"
        ],
        "cardinality_hint": "1:1",
        "rationale": "Every legacy profile has a mirror in the operations system marked legacy. Treating the mirror as an approved Ironbridge profile would count 578 unreviewed profiles as approved; keep the legacy flag until an Approval Chemist reviews each one.",
        "confidence": 0.7
      },
      {
        "suggestion_id": "sg_ib_permit_as_outlet",
        "from_table_key": "ops.facility_permit_code",
        "from_column": "facility_code",
        "to_table_key": "ops.capacity_booking",
        "to_column": "facility_code",
        "relationship_type": "AVAILABLE_AT",
        "relationship_type_alternatives": [
          "PERMITTED_AT"
        ],
        "cardinality_hint": "N:N",
        "rationale": "A permitted code joined to a unit says the unit may take the code; the booking says whether it can in the week. The join on facility alone would make every permitted unit an outlet whatever its bookings, which is the error the acceptance policy rules out.",
        "confidence": 0.58
      },
      {
        "suggestion_id": "sg_ib_requirement_column",
        "from_table_key": "ops.waste_profile",
        "from_column": "customer_requirement",
        "to_table_key": "ops.facility_permit_code",
        "to_column": "process_code",
        "relationship_type": "EXCLUDES",
        "relationship_type_alternatives": [
          "CONSTRAINS"
        ],
        "cardinality_hint": "N:N",
        "rationale": "A requirement such as destruction rules out deep well, landfill and discharge treatment for the stream; the column is free text on 0.2% of profiles, and the binding statement is in QR-14 in Drive.",
        "confidence": 0.66
      },
      {
        "suggestion_id": "sg_ib_manifest_hold",
        "from_table_key": "ops.manifest",
        "from_column": "via_center",
        "to_table_key": "ops.transfer_hold",
        "to_column": "center_code",
        "relationship_type": "ON_PAD_AT",
        "relationship_type_alternatives": [
          "PASSED_THROUGH"
        ],
        "cardinality_hint": "1:1",
        "rationale": "A manifest through a service center has one hold; the hold carries the clock. Joining on center alone would attach every hold at the center to the manifest.",
        "confidence": 0.72
      },
      {
        "suggestion_id": "sg_ib_booking_fee",
        "from_table_key": "fin.state_fee",
        "from_column": "state",
        "to_table_key": "ops.facility",
        "to_column": "state",
        "relationship_type": "CHARGED_AT",
        "relationship_type_alternatives": [
          "APPLIES_TO"
        ],
        "cardinality_hint": "1:N",
        "rationale": "The fee follows the receiving facility's state and its validity dates; a re-route changes the fee with the state, which full cost has to carry.",
        "confidence": 0.74
      }
    ],
