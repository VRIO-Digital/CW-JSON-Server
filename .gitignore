# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Transient file from the db.json editor's atomic write
mock-server/db.json.tmp

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# The two JSON databases live in S3 (see mock-server/store.mjs). npm run db:pull
# brings them back locally when a seed or ingest needs to rewrite them.
mock-server/db.json
mock-server/settings.json

# Local credentials - never commit. Covered by *.local above; named here so a
# stray copy (.backup) cannot slip past it.
mock-server/.env.local
mock-server/.env.local.backup
